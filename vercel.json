{
"version": 2,
"outputDirectory": "dist",
"rewrites": [
{ "source": "/toolz/(.*)", "destination": "/$1" },
{ "source": "/toolz", "destination": "/" }
],
"headers": [
    {
    "source": "/assets/(.*)",
    "headers": [
        {
        "key": "Cache-Control",
        "value": "public, max-age=31536000, immutable"
        }
    ]
    }
],
"buildCommand": "npm run build",
"cleanUrls": true
}

